# Copy this file to `.env.local` and fill in values.
# Next.js loads `.env.local` automatically: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# --- Google Gemini (Genkit AI) — used by `src/ai/genkit.ts` / prioritize-tasks flow ---
# Create a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# If your host only sets this name, it also works:
# GOOGLE_API_KEY=

# --- Optional: Firebase Admin (server-only, if you use Firestore/admin SDK) ---
# Paste the full JSON of a service account key as a single line (escape quotes if needed), or use a file path pattern your host supports.
# FIREBASE_SERVICE_ACCOUNT_KEY_JSON=
