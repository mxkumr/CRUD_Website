# ── Contact form (SMTP) ─────────────────────────────────────────────
# Works with cPanel email, Gmail SMTP, SendGrid SMTP, etc.
#
# cPanel example:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=hello@yourdomain.com
#   SMTP_PASS=your-mailbox-password
#   SMTP_FROM="CRUD Studio <hello@yourdomain.com>"
#   CONTACT_TO=thecrudstudio@gmail.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
